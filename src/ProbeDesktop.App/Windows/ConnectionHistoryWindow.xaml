<Window x:Class="ProbeDesktop.App.Windows.ConnectionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ProbeDesktop.App.Converters"
        Title="连接记录"
        Width="1200" Height="800" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}" Background="{StaticResource PageBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="连接记录窗口">
    <Window.Resources>
        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={x:Static conv:ConnectionToneConverter.Instance}}" Value="ok">
                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={x:Static conv:ConnectionToneConverter.Instance}}" Value="possible">
                    <Setter Property="Background" Value="{StaticResource PossibleLightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={x:Static conv:ConnectionToneConverter.Instance}}" Value="bad">
                    <Setter Property="Background" Value="{StaticResource DangerLightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={x:Static conv:ConnectionToneConverter.Instance}}" Value="warn">
                    <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={x:Static conv:ConnectionToneConverter.Instance}}" Value="ok">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={x:Static conv:ConnectionToneConverter.Instance}}" Value="possible">
                    <Setter Property="Foreground" Value="{StaticResource PossibleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={x:Static conv:ConnectionToneConverter.Instance}}" Value="bad">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={x:Static conv:ConnectionToneConverter.Instance}}" Value="warn">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ContextBadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ContextCheck, Converter={x:Static conv:ConnectionContextToneConverter.Instance}}" Value="ok">
                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContextCheck, Converter={x:Static conv:ConnectionContextToneConverter.Instance}}" Value="warn">
                    <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ContextBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ContextCheck, Converter={x:Static conv:ConnectionContextToneConverter.Instance}}" Value="ok">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContextCheck, Converter={x:Static conv:ConnectionContextToneConverter.Instance}}" Value="warn">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="连接记录" Style="{StaticResource PageTitle}" FontWeight="Normal" />
            <TextBlock Style="{StaticResource Hint}" FontSize="13"
                       Text="本机保存的直连连接测试摘要，只读取本地数据，不联网。不含 Key 或完整响应。" />
        </StackPanel>

        <!-- 筛选：第一行四个等宽字段；第二行左侧日期对、右侧操作按钮。日期对不会被换行孤立 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="配置" Style="{StaticResource ToolbarLabel}" />
                        <TextBox Style="{StaticResource ToolbarSearch}" Tag="配置名称"
                                 Text="{Binding ProfileFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="按配置筛选" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="模型" Style="{StaticResource ToolbarLabel}" />
                        <TextBox Style="{StaticResource ToolbarSearch}" Tag="模型名称"
                                 Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="按模型筛选" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="状态" Style="{StaticResource ToolbarLabel}" />
                        <ComboBox Style="{StaticResource ToolbarCombo}" AutomationProperties.Name="按状态筛选"
                                  SelectedValue="{Binding StatusFilter}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="全部状态" Tag="" IsSelected="True" />
                            <ComboBoxItem Content="成功" Tag="成功" />
                            <ComboBoxItem Content="成功（可能）" Tag="成功（可能）" />
                            <ComboBoxItem Content="失败" Tag="失败" />
                            <ComboBoxItem Content="结果未知" Tag="结果未知" />
                            <ComboBoxItem Content="本地检查通过（未发送）" Tag="本地检查通过" />
                            <ComboBoxItem Content="API 可达（未确认模型）" Tag="API 可达" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="来源" Style="{StaticResource ToolbarLabel}" />
                        <ComboBox Style="{StaticResource ToolbarCombo}" AutomationProperties.Name="按来源筛选"
                                  SelectedValue="{Binding SourceFilter}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="全部来源" Tag="" IsSelected="True" />
                            <ComboBoxItem Content="手动" Tag="手动" />
                            <ComboBoxItem Content="自动巡检" Tag="自动巡检" />
                            <ComboBoxItem Content="立即巡检" Tag="立即巡检" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="开始日期" Style="{StaticResource ToolbarLabel}" />
                            <DatePicker Width="140" Style="{StaticResource ToolbarDate}" SelectedDate="{Binding FromDate}" AutomationProperties.Name="开始日期" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="结束日期" Style="{StaticResource ToolbarLabel}" />
                            <DatePicker Width="140" Style="{StaticResource ToolbarDate}" SelectedDate="{Binding ToDate}" AutomationProperties.Name="结束日期" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="清除筛选" Style="{StaticResource ToolbarTertiaryButton}" Command="{Binding ClearFiltersCommand}" AutomationProperties.Name="清除筛选" />
                        <Button Content="重新读取" Style="{StaticResource ToolbarButton}" Command="{Binding ReloadCommand}" AutomationProperties.Name="重新读取连接记录" />
                        <Button Content="导出脱敏摘要…" Style="{StaticResource ToolbarButton}" Command="{Binding ExportCommand}" AutomationProperties.Name="导出连接记录" />
                        <Button Content="清空全部记录…" Style="{StaticResource ToolbarDangerButton}" Command="{Binding ClearCommand}" AutomationProperties.Name="清空连接记录" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="520" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- 左：列表。行高 48，时间两行，配置与模型单行省略并带提示 -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutomationProperties.Name="连接记录列表"
                              CanUserSortColumns="False" MinRowHeight="48" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="时间" Width="98" MinWidth="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StartedAt, Converter={x:Static conv:LocalTimeConverter.Instance}, ConverterParameter='yyyy-MM-dd'}" />
                                            <TextBlock Style="{StaticResource Hint}" Text="{Binding StartedAt, Converter={x:Static conv:LocalTimeConverter.Instance}, ConverterParameter='HH:mm:ss'}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="配置" Binding="{Binding ProfileName}" Width="96" MinWidth="72" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="模型" Binding="{Binding ModelId}" Width="*" MinWidth="100" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="来源" Binding="{Binding Source, Converter={x:Static conv:EnumTextConverter.Instance}}" Width="78" MinWidth="70" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTemplateColumn Header="结果" Width="96" MinWidth="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgeBorder}">
                                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Converter={x:Static conv:ConnectionResultTextConverter.Instance}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="标记读取" Width="86" MinWidth="78">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ContextBadgeBorder}">
                                            <TextBlock Style="{StaticResource ContextBadgeText}" Text="{Binding ContextCheck, Converter={x:Static conv:EnumTextConverter.Instance}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- 空状态：列表没有可显示的行时居中说明 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding View.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SubtleBrush}" HorizontalAlignment="Center"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Path Data="{StaticResource IconHistory}" Style="{StaticResource LineIcon}" Width="22" Height="22" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="暂无可显示的记录" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Hint}" TextAlignment="Center" MaxWidth="320" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：详情。标题与删除按钮同一行，按钮固定靠右；内容可滚动，长错误信息不裁剪 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="记录详情" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="删除本机记录" Style="{StaticResource ToolbarDangerButton}" Margin="12,0,0,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="100"
                                Command="{Binding DeleteCommand}" AutomationProperties.Name="删除本机连接记录" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,8,0">
                            <ItemsControl ItemsSource="{Binding DetailRows}" Focusable="False" AutomationProperties.Name="记录详情">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" LineHeight="20" />
                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ValueText}"
                                                         TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight"
                                                         AutomationProperties.Name="{Binding Label}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Margin="0,16,0,0" Visibility="{Binding DetailMessage, Converter={StaticResource HasValueToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InfoCallout}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailTone}" Value="danger">
                                                <Setter Property="Background" Value="{StaticResource DangerLightBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DetailTone}" Value="warn">
                                                <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DetailTone}" Value="possible">
                                                <Setter Property="Background" Value="{StaticResource PossibleLightBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource PossibleBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="说明" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding DetailMessage, Mode=OneWay}" Style="{StaticResource ValueText}"
                                             TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight"
                                             AutomationProperties.Name="结果说明" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SubtleBrush}" HorizontalAlignment="Center"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Path Data="{StaticResource IconDocument}" Style="{StaticResource LineIcon}" Width="22" Height="22" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="未选择记录" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="在左侧选择一条记录查看摘要。" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Hint}" />
            <TextBlock Text="{Binding StatsText}" Style="{StaticResource Hint}" Margin="0,4,0,0" AutomationProperties.Name="分项统计" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
