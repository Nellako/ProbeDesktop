<Window x:Class="ProbeDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProbeDesktop.App.Views"
        xmlns:themes="clr-namespace:ProbeDesktop.App.Themes"
        xmlns:conv="clr-namespace:ProbeDesktop.App.Converters"
        Title="中转模型检测（BazaarLink Probe 非官方客户端）"
        Width="1360" Height="900" MinWidth="1100" MinHeight="780"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="Normal"
        Foreground="{StaticResource TextBrush}" Background="{StaticResource PageBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="中转模型检测主窗口">
    <DockPanel>
        <!-- 读取失败提示：不进入页面，避免以空数据覆盖本地文件 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource DangerCallout}" Margin="16,12,16,0"
                Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="重新读取" Command="{Binding ReloadCommand}" Margin="12,0,0,0"
                        AutomationProperties.Name="重新读取本地数据" />
                <Path DockPanel.Dock="Left" Data="{StaticResource IconAlert}" Style="{StaticResource LineIcon}"
                      Stroke="{StaticResource DangerBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
        <!-- 外壳（白色左导航、顶栏、状态行）定义在 Themes/Controls.xaml 的 NavTabControl 中。
             迁移进行中或导入后等待重启时整体禁用（IsInteractive），只保留下方覆盖层的取消/退出。 -->
        <TabControl Style="{StaticResource NavTabControl}" SelectedIndex="{Binding SelectedPage}"
                    IsEnabled="{Binding IsInteractive}" AutomationProperties.Name="主导航">
            <TabItem Header="配置管理" AutomationProperties.Name="配置管理页"
                     themes:NavAssist.Group="工作台" themes:NavAssist.Icon="{StaticResource IconProfiles}">
                <views:ProfilesView DataContext="{Binding Profiles}" />
            </TabItem>
            <TabItem Header="模型与检测" AutomationProperties.Name="模型与检测页"
                     themes:NavAssist.Icon="{StaticResource IconProbe}">
                <views:ProbeView DataContext="{Binding Probe}" />
            </TabItem>
            <TabItem Header="连接巡检" AutomationProperties.Name="连接巡检页"
                     themes:NavAssist.Group="监控" themes:NavAssist.Icon="{StaticResource IconProbe}">
                <views:InspectionView DataContext="{Binding Inspection}" />
            </TabItem>
            <TabItem Header="身份识别巡检" AutomationProperties.Name="身份识别巡检页"
                     themes:NavAssist.Icon="{StaticResource IconShield}">
                <views:IdentityInspectionView DataContext="{Binding IdentityInspection}" />
            </TabItem>
            <TabItem Header="连接记录" AutomationProperties.Name="连接记录页"
                     themes:NavAssist.Icon="{StaticResource IconHistory}">
                <StackPanel Margin="32,28" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="连接记录" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,16" TextWrapping="Wrap"
                               Text="直连连接测试的本地摘要记录。窗口可与主界面同时打开，只读取本机数据，不联网。" />
                    <Button Content="打开连接记录窗口" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Command="{Binding OpenConnectionHistoryCommand}" AutomationProperties.Name="打开连接记录窗口" />
                </StackPanel>
            </TabItem>
            <TabItem Header="鉴别记录" AutomationProperties.Name="鉴别记录页"
                     themes:NavAssist.Icon="{StaticResource IconHistory}">
                <StackPanel Margin="32,28" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="模型鉴别记录" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,16" TextWrapping="Wrap"
                               Text="BazaarLink 鉴别检测的本地历史。只读取本机数据，不联网；需要更新进度请在窗口中操作。" />
                    <Button Content="打开模型鉴别记录窗口" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Command="{Binding OpenProbeHistoryCommand}" AutomationProperties.Name="打开模型鉴别记录窗口" />
                </StackPanel>
            </TabItem>
            <TabItem Header="帮助与设置" AutomationProperties.Name="帮助与设置页"
                     themes:NavAssist.Group="系统" themes:NavAssist.Icon="{StaticResource IconHelp}">
                <views:HelpView />
            </TabItem>
        </TabControl>

        <!-- 完整数据迁移：忙碌 / 等待重启覆盖层，位于导航之上，阻止点击下层 -->
        <Grid DataContext="{Binding Migration}" Background="#99FFFFFF"
              Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" MaxWidth="620" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="完整数据备份与迁移进行中" Style="{StaticResource SectionTitle}" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" AutomationProperties.Name="迁移进行中" />
                        <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="迁移期间其他操作暂时禁用，记录窗口也不可操作。迁移不联网。" />
                        <Button Content="取消" Command="{Binding CancelCommand}" HorizontalAlignment="Left" MinWidth="96"
                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="取消迁移" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsRestartRequired, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="需要重新打开程序" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding RestartText}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="21" />
                        <Button Content="退出程序" Style="{StaticResource PrimaryButton}" Command="{Binding ExitCommand}"
                                HorizontalAlignment="Left" MinWidth="120" AutomationProperties.Name="退出程序以重新打开" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
