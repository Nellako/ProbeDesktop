<UserControl x:Class="ProbeDesktop.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="配置管理" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Chip}" Margin="12,2,0,0">
                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding Count, StringFormat='{}{0} 个配置'}" />
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" FontSize="13"
                       Text="管理多个中转站配置（名称、API Base URL、API Key）。Key 使用 Windows DPAPI 加密保存在本机，界面不会回显。" />
        </StackPanel>

        <!-- 左：列表 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="新建配置(_N)" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Command="{Binding NewCommand}" AutomationProperties.Name="新建配置" />
                        <Button DockPanel.Dock="Right" Content="清除" Style="{StaticResource TertiaryButton}" Margin="8,0,0,0"
                                Command="{Binding ClearSearchCommand}" AutomationProperties.Name="清除搜索" />
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="按名称、Base URL 或默认模型搜索"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxWidth="420" HorizontalAlignment="Left"
                                 AutomationProperties.Name="搜索配置" AutomationProperties.HelpText="按名称、Base URL 或默认模型搜索"
                                 ToolTip="按名称、Base URL 或默认模型搜索" />
                    </DockPanel>
                    <!-- 模型列表拉取：两个独立按钮。WrapPanel 保证窄窗口或长文字时换行而不是被裁切 -->
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="拉取所选配置(_F)" Margin="0,0,8,6" MinWidth="120" Command="{Binding RefreshSelectedCommand}"
                                AutomationProperties.Name="拉取所选配置的模型列表"
                                ToolTip="只拉取列表中选中的这一个配置（使用已保存的内容）。确认后向该配置的地址发送一次 GET，不经过 BazaarLink。" />
                        <Button Content="全部拉取(_G)" Margin="0,0,8,6" MinWidth="104" Command="{Binding RefreshAllCommand}"
                                AutomationProperties.Name="全部拉取模型列表"
                                ToolTip="对全部配置各拉取一次：统一确认一次后串行发送，不重试，某个失败不影响其他。不受上方搜索筛选影响。" />
                        <ProgressBar IsIndeterminate="True" Width="64" Height="4" Margin="4,0,8,6" VerticalAlignment="Center"
                                     AutomationProperties.Name="正在拉取模型列表"
                                     Visibility="{Binding IsRefreshRunning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding RefreshProgress}" Style="{StaticResource Hint}" Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap" MaxWidth="260"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding RefreshProgress, Converter={StaticResource HasValueToVis}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding RefreshSummary}" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding RefreshSummary, Converter={StaticResource HasValueToVis}}" />
                </StackPanel>
                <Grid>
                    <DataGrid x:Name="ProfileGrid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" Margin="0,0,0,8" MinRowHeight="44"
                              AutomationProperties.Name="配置列表">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" MinWidth="90" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="协议" Binding="{Binding ProtocolDisplay}" Width="118" MinWidth="90" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="Base URL" Binding="{Binding BaseUrl}" Width="*" MinWidth="80" ElementStyle="{StaticResource ClampCell}" />
                            <!-- 模型缓存 + 逐配置拉取状态（第二行，带颜色）。不新增列，避免最小宽度下出现横向滚动 -->
                            <DataGridTemplateColumn Header="模型缓存 / 拉取状态" Width="180" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="2,0">
                                            <TextBlock Text="{Binding ModelSummary}" Style="{StaticResource MutedCell}" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" ToolTip="{Binding ModelSummaryTooltip}" />
                                            <TextBlock Text="{Binding RefreshStateText}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       ToolTip="{Binding RefreshStateText}" AutomationProperties.Name="拉取状态"
                                                       Visibility="{Binding RefreshStateText, Converter={StaticResource HasValueToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RefreshTone}" Value="info">
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RefreshTone}" Value="ok">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RefreshTone}" Value="warn">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RefreshTone}" Value="bad">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding Count, Converter={StaticResource NoValueToVis}}">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconEmptyBox}" Style="{StaticResource LineIcon}" Stroke="{StaticResource PrimaryBrush}"
                                  Width="22" Height="22" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="还没有配置" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="点击“新建配置”添加第一个中转站。" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 右：编辑（按内容高度显示，超出可滚动，不铺满整列） -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
            <Grid>
                <StackPanel Margin="24,40" HorizontalAlignment="Center"
                            Visibility="{Binding IsEditorVisible, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SubtleBrush}" HorizontalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Path Data="{StaticResource IconDocument}" Style="{StaticResource LineIcon}" Width="22" Height="22" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="未选择配置" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="在左侧选择一个配置进行编辑，或点击“新建配置”。" Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="260" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="24,20,24,20"
                              Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,0" />

                        <Label Content="名称(_A)" Target="{Binding ElementName=NameBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 AutomationProperties.Name="配置名称" />

                        <Label Content="API 协议(_P)" Target="{Binding ElementName=ProtocolBox}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ProtocolBox" ItemsSource="{Binding ProtocolOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding EditProtocol}" AutomationProperties.Name="API 协议" />

                        <Label Content="API Base URL(_U)" Target="{Binding ElementName=UrlBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UrlBox" Text="{Binding EditBaseUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048"
                                 FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="API Base URL" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="填写 API 根路径，例如 https://relay.example.com/v1 。程序不会自动补 /v1，会按所选协议追加 /responses、/messages 或 /chat/completions，请不要自己填写。" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"
                                   Text="{Binding ProtocolPathHint}" AutomationProperties.Name="最终请求路径" />
                        <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"
                                   Text="{Binding BaseUrlAdvice}" Visibility="{Binding BaseUrlAdvice, Converter={StaticResource HasValueToVis}}" />

                        <Label Content="API Key(_K)" Target="{Binding ElementName=KeyBox}" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="KeyBox" MaxLength="8192" AutomationProperties.Name="API Key 输入框"
                                     AutomationProperties.HelpText="{Binding KeyHint}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding KeyHint}" />

                        <Label Content="默认模型（可选）(_M)" Target="{Binding ElementName=ModelBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ModelBox" Text="{Binding EditDefaultModel, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"
                                 FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="默认模型" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="也可以在“模型与检测”页从拉取的列表中设为默认。" />

                        <Border Style="{StaticResource DangerCallout}" Margin="0,16,0,0"
                                Visibility="{Binding Validation, Converter={StaticResource HasValueToVis}}">
                            <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" AutomationProperties.LiveSetting="Assertive" />
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="删除配置" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"
                                        AutomationProperties.Name="删除配置" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SaveButton" Content="保存(_S)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" MinWidth="80"
                                            Click="OnSaveClick" IsEnabled="{Binding CanSave}" AutomationProperties.Name="保存配置" />
                                    <Button Content="取消" Command="{Binding CancelCommand}" AutomationProperties.Name="取消编辑" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="正在保存…" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}" />
                        <Border Background="{StaticResource SubtleBrush}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0"
                                Visibility="{Binding SelectedDetail, Converter={StaticResource HasValueToVis}}">
                            <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource Hint}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
