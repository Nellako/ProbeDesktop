<UserControl x:Class="ProbeDesktop.App.Views.ConnectionTestCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="ToneText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="possible">
                    <Setter Property="Foreground" Value="{StaticResource PossibleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="bad">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource PrimarySoftBorderBrush}" BorderThickness="1.5">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="本地直连连接测试" Style="{StaticResource SectionTitle}" Margin="0" />
                <Border Style="{StaticResource Chip}" Margin="10,0,0,0">
                    <TextBlock Style="{StaticResource ChipText}" Text="只连接你的中转站" />
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding TargetText}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding RecipientText}" FontFamily="{StaticResource MonoFont}"
                       Visibility="{Binding RecipientText, Converter={StaticResource HasValueToVis}}" />

            <Border Style="{StaticResource InfoCallout}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextBrush}"
                               Text="{Binding ExplainText}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="“本地检查”不联网，只检查 Base URL、Key 和模型 ID 格式，通过也不代表 API 可达或模型可用。" />
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,14,0,0">
                <Button Content="本地检查(_L)" Command="{Binding CheckCommand}" Margin="0,0,10,0" MinWidth="104"
                        AutomationProperties.Name="本地检查" ToolTip="不联网，只检查格式" />
                <Button Content="测试连接(_N)…" Style="{StaticResource PrimaryButton}" Command="{Binding TestCommand}" MinWidth="128"
                        AutomationProperties.Name="测试连接" ToolTip="确认后直接向中转站发送一次约256 token连接与标记校验请求，可能产生费用" />
                <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="12,0,0,0" VerticalAlignment="Center"
                             AutomationProperties.Name="连接测试进行中" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Foreground="{StaticResource PrimaryBrush}"
                       Text="{Binding BusyText}" Visibility="{Binding BusyText, Converter={StaticResource HasValueToVis}}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding ActionNote}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding ActionNote, Converter={StaticResource HasValueToVis}}" />

            <!-- 四个独立状态：本地检查 / API 响应 / 模型响应 / 标记读取 -->
            <ItemsControl ItemsSource="{Binding Stages}" Margin="0,14,0,0" Focusable="False" AutomationProperties.Name="连接测试状态">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" AutomationProperties.Name="{Binding Label}">
                                    <TextBlock Text="{Binding State}" Style="{StaticResource ToneText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                               Visibility="{Binding Detail, Converter={StaticResource HasValueToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ResultMeta}" Style="{StaticResource Hint}" Margin="0,8,0,0" FontFamily="{StaticResource MonoFont}"
                       Visibility="{Binding ResultMeta, Converter={StaticResource HasValueToVis}}" />
            <TextBlock Text="{Binding HiddenResultNote}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Visibility="{Binding HiddenResultNote, Converter={StaticResource HasValueToVis}}" />

            <!-- 自动测试 -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="定时测试" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="此处只做所选单个模型的手动测试，从不自动发送。定时测试已移到左侧“连接巡检”页：它仅巡检已勾选且已授权的配置/缓存模型，不局限于当前选中的模型，切换这里的配置或模型也不会关闭它。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
