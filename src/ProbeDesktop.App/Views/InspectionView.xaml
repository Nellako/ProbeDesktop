<UserControl x:Class="ProbeDesktop.App.Views.InspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ProbeDesktop.App.Views"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <!-- 色调文本：配置状态 / 模型授权 / 本轮结果。ok 绿、possible 蓝、warn 橙、bad 红，其余灰 -->
        <Style x:Key="NodeStatusText" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="ok"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelAuthText" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AuthTone}" Value="ok"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding AuthTone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultTone" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="possible"><Setter Property="Foreground" Value="{StaticResource PossibleBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ContextBadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ContextTone}" Value="ok">
                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContextTone}" Value="possible">
                    <Setter Property="Background" Value="{StaticResource PossibleLightBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PossibleBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContextTone}" Value="warn">
                    <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContextTone}" Value="bad">
                    <Setter Property="Background" Value="{StaticResource DangerLightBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ContextBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ContextTone}" Value="ok"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ContextTone}" Value="possible"><Setter Property="Foreground" Value="{StaticResource PossibleBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ContextTone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding ContextTone}" Value="bad"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 模型勾选行 -->
        <DataTemplate x:Key="ModelRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Id}" ToolTip="{Binding Id}">
                    <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                </CheckBox>
                <TextBlock Grid.Column="1" Text="{Binding AuthText}" Style="{StaticResource ModelAuthText}" Margin="12,0,6,0" />
            </Grid>
        </DataTemplate>

        <!-- 配置节点：配置勾选 + 展开箭头 + 可展开的子模型 -->
        <DataTemplate x:Key="ProfileNode">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Style="{StaticResource ChevronToggle}" IsChecked="{Binding IsExpanded}" VerticalAlignment="Top"
                                      IsEnabled="{Binding CanSelect}" AutomationProperties.Name="展开或收起模型列表"
                                      ToolTip="展开后可逐个选择该配置的缓存模型" />
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <CheckBox IsChecked="{Binding IsIncluded}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Name}"
                                      ToolTip="勾选表示纳入巡检；取消勾选不会清除下面已选的模型">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                            <TextBlock Margin="28,0,0,0" Style="{StaticResource NodeStatusText}" Text="{Binding StatusText}"
                                       Visibility="{Binding StatusText, Converter={StaticResource HasValueToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ProtocolText}" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <Border Margin="32,8,0,0" Padding="12,8" Background="{StaticResource SubtleBrush}" CornerRadius="8"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="全选此配置的模型" Margin="0,0,8,4" MinWidth="0" Command="{Binding SelectAllCommand}"
                                        AutomationProperties.Name="全选此配置的缓存模型" ToolTip="明确选中该配置当前缓存的全部模型；只是选择，不会授权" />
                                <Button Content="清除选择" Margin="0,0,8,4" MinWidth="0" Command="{Binding ClearModelsCommand}"
                                        AutomationProperties.Name="清除此配置的模型选择" />
                            </WrapPanel>
                            <!-- 虚拟化 + 限高：缓存最多可达上千个模型 -->
                            <ItemsControl ItemsSource="{Binding Models}" ItemTemplate="{StaticResource ModelRow}"
                                          VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"
                                          views:ScrollForwarding.Enabled="True" Focusable="False" AutomationProperties.Name="缓存模型勾选列表">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      Focusable="False" CanContentScroll="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 本轮结果行 -->
        <DataTemplate x:Key="ResultRow">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Hint}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProfileName}" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="2" Text="{Binding ModelId}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelId}" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="3" Text="{Binding ResultText}" Style="{StaticResource ResultTone}" Margin="0,0,8,0" />
                    <Border Grid.Column="4" Style="{StaticResource ContextBadgeBorder}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ContextText}" Style="{StaticResource ContextBadgeText}" />
                    </Border>
                    <TextBlock Grid.Column="5" Text="{Binding Detail}" Style="{StaticResource ClampCell}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0" Focusable="False">
        <StackPanel Margin="0,0,0,8" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="连接巡检" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,16"
                       Text="直连已确认的配置和模型，不调用 BazaarLink。最大重试可选 0、1、2 次（默认 0）；每个目标每轮最多 1、2、3 次请求，不是费用上限。" />

            <!-- 1. 状态、间隔与操作 -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NextStartText}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Visibility="{Binding NextStartText, Converter={StaticResource HasValueToVis}}" />
                    <TextBlock Text="{Binding CurrentItemText}" Style="{StaticResource Hint}" Margin="0,4,0,0" Foreground="{StaticResource PrimaryBrush}"
                               Visibility="{Binding CurrentItemText, Converter={StaticResource HasValueToVis}}" />

                    <WrapPanel Margin="0,14,0,0">
                        <Label Content="间隔（分钟）(_M)" Target="{Binding ElementName=GlobalIntervalBox}" VerticalAlignment="Center" Padding="0,0,8,6" />
                        <TextBox x:Name="GlobalIntervalBox" Width="72" MaxLength="3" Margin="0,0,10,6"
                                 Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="连接巡检间隔分钟"
                                 ToolTip="10 至 480 分钟，默认 30。确认巡检设置后生效。" />
                        <Label Content="最大重试次数(_R)" Target="{Binding ElementName=RetryBox}" VerticalAlignment="Center" Padding="0,0,8,6" />
                        <ComboBox x:Name="RetryBox" Width="64" Margin="0,0,16,6" ItemsSource="{Binding RetryOptions}"
                                  SelectedItem="{Binding MaxRetries, Mode=TwoWay}" AutomationProperties.Name="最大重试次数" />
                        <Button Content="{Binding ToggleText}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6" MinWidth="136"
                                Command="{Binding ToggleCommand}" AutomationProperties.Name="开关自动连接巡检" />
                        <Button Content="立即巡检一轮" Margin="0,0,10,6" Command="{Binding RunOnceCommand}"
                                AutomationProperties.Name="立即巡检一轮" ToolTip="使用已确认的设置，不改变自动开关。" />
                        <Button Content="确认巡检设置…(_S)" Margin="0,0,10,6" Command="{Binding ConfirmScopeCommand}"
                                AutomationProperties.Name="确认连接巡检设置" ToolTip="一起保存范围、间隔和最大重试次数。" />
                    </WrapPanel>
                    <TextBlock Text="{Binding IntervalHint}" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding Status, Converter={StaticResource HasValueToVis}}" />
                </StackPanel>
            </Border>

            <!-- 2. 巡检范围：配置勾选 + 可展开子模型勾选 -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="巡检范围" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Text="勾选配置，并展开选择其中要巡检的缓存模型。取消勾选配置不会清除已选的模型；模型缓存更新后，已不存在的模型会从选择中移除，新增的模型默认不选。" />
                    <TextBlock Text="{Binding ScopeSummary}" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding PendingText}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Visibility="{Binding PendingText, Converter={StaticResource HasValueToVis}}" />

                    <ItemsControl ItemsSource="{Binding ProfileNodes}" ItemTemplate="{StaticResource ProfileNode}" Margin="0,12,0,0"
                                  Focusable="False" AutomationProperties.Name="巡检范围配置列表" />
                    <StackPanel Margin="0,20" HorizontalAlignment="Center" Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="还没有配置" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="请先在“配置管理”新建配置并拉取模型列表。" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 最新一轮：状态 + 逐模型结果（只显示最新一轮） -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="最新一轮" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding RoundStatusText}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding RoundCountsText}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Visibility="{Binding RoundCountsText, Converter={StaticResource HasValueToVis}}" />
                    <Grid Margin="0,12,0,6" Visibility="{Binding HasRound, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="124" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Column="1" Text="配置" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Column="2" Text="模型" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Column="3" Text="结果" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Column="4" Text="标记读取" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Column="5" Text="说明" Style="{StaticResource Hint}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RoundResults}" ItemTemplate="{StaticResource ResultRow}" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"
                                  views:ScrollForwarding.Enabled="True" AutomationProperties.Name="最新一轮各模型结果">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False" CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding ResultsNote}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Visibility="{Binding ResultsNote, Converter={StaticResource HasValueToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
