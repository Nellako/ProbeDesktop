<UserControl x:Class="ProbeDesktop.App.Views.ProbeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ProbeDesktop.App.Views"
             xmlns:local="clr-namespace:ProbeDesktop.App.Views"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="RecentTone" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="possible">
                    <Setter Property="Foreground" Value="{StaticResource PossibleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="bad">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecentContextBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ContextTone}" Value="ok">
                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContextTone}" Value="warn">
                    <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecentContextText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ContextTone}" Value="ok">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContextTone}" Value="warn">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="RecentLineTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Hint}" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" AutomationProperties.Name="{Binding Title}">
                        <WrapPanel>
                            <TextBlock Text="{Binding State}" Style="{StaticResource RecentTone}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Border Style="{StaticResource RecentContextBorder}"
                                    Visibility="{Binding ContextBadge, Converter={StaticResource HasValueToVis}}">
                                <TextBlock Style="{StaticResource RecentContextText}" Text="{Binding ContextBadge}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" VerticalAlignment="Center"
                                    Visibility="{Binding HasRecord, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource ChipText}" Text="历史" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Visibility="{Binding Meta, Converter={StaticResource HasValueToVis}}" />
                        <TextBlock Text="{Binding Detail}" Margin="0,2,0,0"
                                   Visibility="{Binding Detail, Converter={StaticResource HasValueToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DetailTone}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" Margin="0,2,0,0" Foreground="{StaticResource WarningBrush}"
                                   Visibility="{Binding Note, Converter={StaticResource HasValueToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" MinWidth="460" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,20">
            <TextBlock Text="模型与检测" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,0"
                       Text="选择配置 → 拉取、选择或手填模型 → 先做“本地直连连接测试”，需要时再“提交 BazaarLink 鉴别检测”。模型列表、连接测试和 Probe 提交每次都会先弹出确认，点“否”不会联网。" />
        </StackPanel>

        <!-- STEP 1 配置选择 -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,20">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="拉取模型列表(_R)" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"
                        Command="{Binding RefreshModelsCommand}" VerticalAlignment="Center"
                        AutomationProperties.Name="拉取当前配置的模型列表"
                        ToolTip="只拉取当前所选配置：确认后按该配置的协议直接向所选中转站发送 GET {Base URL}/models（Claude 协议使用 x-api-key 头）。拉取全部配置请到“配置管理”页。" />
                <TextBlock DockPanel.Dock="Left" Text="STEP 1" Style="{StaticResource StepLabel}" />
                <Label DockPanel.Dock="Left" Content="配置(_P)" Target="{Binding ElementName=ProfileCombo}" VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Padding="0,0,10,0" />
                <ComboBox x:Name="ProfileCombo" DockPanel.Dock="Left" Width="220" VerticalAlignment="Center"
                          ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" DisplayMemberPath="Name"
                          AutomationProperties.Name="选择配置" />
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBrush}" Margin="16,2" />
                <TextBlock Text="{Binding ProfileSummary}" Style="{StaticResource Hint}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding ProfileSummary}" />
            </DockPanel>
        </Border>

        <!-- STEP 2 左：模型列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,12">
                    <TextBlock Text="STEP 2" Style="{StaticResource StepLabel}" />
                    <TextBlock Text="模型列表" Style="{StaticResource SectionTitle}" Margin="0" />
                </StackPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="清除" Style="{StaticResource TertiaryButton}" Margin="4,0,0,0"
                            Command="{Binding ClearModelSearchCommand}" AutomationProperties.Name="清除模型搜索" />
                    <TextBox Style="{StaticResource SearchBox}" Tag="搜索模型 ID 或 owned_by"
                             Text="{Binding ModelSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索模型"
                             ToolTip="按模型 ID 或 owned_by 搜索" IsEnabled="{Binding HasProfile}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ModelCountText}" Style="{StaticResource Hint}" Margin="4,0,0,8"
                           Visibility="{Binding ModelCountText, Converter={StaticResource HasValueToVis}}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Foreground="{StaticResource PrimaryBrush}" Margin="4,0,0,8"
                           Text="正在拉取模型列表…" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="设为默认模型" Command="{Binding SetDefaultCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="设为默认模型" ToolTip="把当前选中或手填的模型保存为此配置的默认模型" />
                            <Button Content="选用默认模型" Command="{Binding UseDefaultCommand}"
                                    AutomationProperties.Name="选用默认模型" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding Status, Converter={StaticResource HasValueToVis}}" />
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding ModelsView}" SelectedItem="{Binding SelectedModel}" AutomationProperties.Name="模型列表"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel AutomationProperties.Name="{Binding Id}">
                                <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Id}" />
                                <TextBlock Text="{Binding OwnedBy, StringFormat='owned_by：{0}'}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                           Visibility="{Binding OwnedBy, Converter={StaticResource HasValueToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右栏：调用模型 / 直连连接测试 / BazaarLink 检测 -->
        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <!-- STEP 3 公共：调用模型。连接测试与 BazaarLink 检测共用，不属于任何第三方卡片 -->
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="STEP 3" Style="{StaticResource StepLabel}" />
                            <TextBlock Text="调用模型" Style="{StaticResource SectionTitle}" Margin="0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="在左侧列表选择，或在此手填。下方的“本地直连连接测试”和“提交 BazaarLink 鉴别检测”都使用这个模型。" />
                        <Label Content="手填模型 ID（填写后优先于列表选择）(_I)" Target="{Binding ElementName=ManualBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ManualBox" Text="{Binding ManualModel, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"
                                 FontFamily="{StaticResource MonoFont}" IsEnabled="{Binding HasProfile}"
                                 AutomationProperties.Name="手填模型 ID" />
                        <!-- 将要检测的模型：左侧细蓝条强调，不铺大色块 -->
                        <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="3,0,0,0" Background="{StaticResource SubtleBrush}"
                                CornerRadius="0,6,6,0" Padding="12,8" Margin="0,10,0,0">
                            <TextBlock Text="{Binding EffectiveModelText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 该模型最近结果：按“配置 + 模型”分别显示最近一次已完成的直连测试和鉴别检测（含失败），来自本地历史，不联网 -->
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,20">
                    <StackPanel DataContext="{Binding Recent}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="该模型最近结果" Style="{StaticResource SectionTitle}" Margin="0" />
                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource ChipText}" Text="本地历史" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Hint}" Margin="0,0,0,6" />
                        <ContentControl Content="{Binding Connection}" Focusable="False" ContentTemplate="{StaticResource RecentLineTemplate}" />
                        <ContentControl Content="{Binding Probe}" Focusable="False" ContentTemplate="{StaticResource RecentLineTemplate}" />
                    </StackPanel>
                </Border>

                <local:ConnectionTestCard DataContext="{Binding Connection}" Margin="0,0,0,20" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="STEP 4" Style="{StaticResource StepLabel}" />
                            <TextBlock Text="提交 BazaarLink 鉴别检测" Style="{StaticResource SectionTitle}" Margin="0" />
                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Background="{StaticResource WarningLightBrush}">
                                <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource WarningBrush}" Text="第三方服务" />
                            </Border>
                        </StackPanel>

                        <Label Content="声明模型（可选）(_C)" Target="{Binding ElementName=ClaimedBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ClaimedBox" Text="{Binding ClaimedModel, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"
                                 FontFamily="{StaticResource MonoFont}" IsEnabled="{Binding HasProfile}"
                                 AutomationProperties.Name="声明模型" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="中转站宣称提供的模型（例如 claude-sonnet-4）。留空则由服务按调用模型判断。" />

                        <Border Style="{StaticResource Callout}" Margin="0,16,0,0"
                                Visibility="{Binding ActiveRunWarning, Converter={StaticResource HasValueToVis}}">
                            <TextBlock Text="{Binding ActiveRunWarning}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                        </Border>

                        <Border Style="{StaticResource Callout}" Margin="0,16,0,0"
                                Visibility="{Binding ProbeProtocolNote, Converter={StaticResource HasValueToVis}}">
                            <TextBlock Text="{Binding ProbeProtocolNote}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Border>

                        <!-- 外发说明：始终可见 -->
                        <Border Style="{StaticResource Callout}" Margin="0,16,0,0">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Data="{StaticResource IconAlert}" Style="{StaticResource LineIcon}"
                                      Stroke="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel>
                                    <TextBlock Text="外发提示" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,4" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextBrush}"
                                               Text="提交会把 Base URL、完整 API Key、模型和所选协议发送给 BazaarLink（https://bazaarlink.ai/api/probe/run），可能产生费用，报告可能公开。点击后会先弹出确认并显示协议，仅确认后才会发送，且只发送一次。" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,20,0,0">
                            <Button DockPanel.Dock="Left" Content="提交到 BazaarLink(_T)…" Style="{StaticResource PrimaryButton}" MinWidth="128"
                                    Command="{Binding StartProbeCommand}" AutomationProperties.Name="提交到 BazaarLink 检测" />
                            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="4" Margin="12,0,0,0"
                                         VerticalAlignment="Center" AutomationProperties.Name="提交中"
                                         Visibility="{Binding IsSubmitting, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding SubmitStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="本次检测" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasCurrentRun, Converter={StaticResource InverseBoolToVis}}">
                            <Path Data="{StaticResource IconDocument}" Style="{StaticResource LineIcon}" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="尚未在本次运行中提交检测。以往记录请到“历史记录”页查看。" />
                        </StackPanel>
                        <Border Visibility="{Binding HasCurrentRun, Converter={StaticResource BoolToVis}}">
                            <views:RunDetailView DataContext="{Binding CurrentRun}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
