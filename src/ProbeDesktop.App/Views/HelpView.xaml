<UserControl x:Class="ProbeDesktop.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="Para" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardHead" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,20">
                <TextBlock Text="帮助与设置" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,0"
                           Text="本程序是 BazaarLink Probe 公开 API 的个人自用、非官方桌面客户端，与 BazaarLink 无隶属或背书关系。" />
            </StackPanel>

            <!-- 数据位置 + 完整数据备份与迁移（整行，同一行内上下排列以保持 8 行布局） -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHead}">
                        <Border Style="{StaticResource IconBadge}">
                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource LineIcon}" Stroke="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="数据位置" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="打开数据目录" Command="{Binding OpenDataDirectoryCommand}" Margin="12,0,0,0"
                                    AutomationProperties.Name="打开数据目录" />
                            <TextBox Style="{StaticResource ValueText}" Text="{Binding DataDirectory, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"
                                     VerticalAlignment="Center" AutomationProperties.Name="数据目录路径" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding DataDirectoryNote}" Style="{StaticResource Hint}" Margin="0,6,0,12" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 默认位于 %LOCALAPPDATA%\ProbeDesktop，不在云同步文件夹中。配置、模型缓存和检测历史都保存在这里，没有云端账号或同步。" />
                    <TextBlock Style="{StaticResource Para}" Margin="0"
                               Text="• 测试时可用启动参数 --data-dir &lt;绝对本地路径&gt; 指定隔离目录（不支持网络路径或云同步目录）。同一数据目录同时只能运行一个程序窗口。" />
                </StackPanel>
            </Border>

            <!-- 完整数据备份与迁移（含 Key，密码加密）；与不含 Key 的脱敏报告导出区分 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20" DataContext="{Binding Migration}">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHead}">
                        <Border Style="{StaticResource IconBadge}">
                            <Path Data="{StaticResource IconShield}" Style="{StaticResource LineIcon}" Stroke="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="完整数据备份与迁移（含 API Key，密码加密）" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 用于换电脑或重装系统：在原电脑导出一个用密码加密的迁移包，在新电脑的空数据目录中导入。包含全部配置与 API Key、历史密钥（用于脱敏）、模型缓存、鉴别记录与连接记录、巡检选择与间隔、通知偏好；已删除的记录不会恢复。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 这与鉴别记录的“导出 JSON”和连接记录的“导出脱敏摘要”不同：那些报告不含 Key，迁移包含 Key。任何人同时拿到迁移包和密码就能读取全部数据；密码丢失后无法恢复，程序不保存、也无法找回密码。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 导出只新建文件，不覆盖已有文件，也不能保存到程序数据目录；程序不会上传或同步迁移包。导入只允许空的数据目录，不覆盖、不合并；导入前只显示数量预览，确认后才写入，并用新电脑当前 Windows 账户的 DPAPI 重新加密。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 导入成功后必须退出并用同一数据目录重新打开。重新打开后连接巡检和身份识别巡检均为关闭，外发授权需要重新确认；迁移的未结束鉴别任务不会自动查询（重启后也不会），须在鉴别记录中手动确认接收方后才读取进度，不会重新提交。导出与导入都不联网。" />
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="导出完整迁移包…" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6" MinWidth="120"
                                Command="{Binding ExportCommand}" AutomationProperties.Name="导出完整数据迁移包" />
                        <Button Content="从迁移包导入…" Margin="0,0,10,6" MinWidth="120"
                                Command="{Binding ImportCommand}" AutomationProperties.Name="从完整数据迁移包导入" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Status, Converter={StaticResource HasValueToVis}}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="当前数据服务不支持迁移。" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- 密钥保护 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHead}">
                        <Border Style="{StaticResource IconBadge}">
                            <Path Data="{StaticResource IconShield}" Style="{StaticResource LineIcon}" Stroke="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="密钥保护（DPAPI）" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Para}"
                               Text="• API Key 使用 Windows DPAPI（当前用户范围）加密保存。解密通常需要原设备和原 Windows 用户上下文；迁移、重装或更换账户后不保证能解密。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• DPAPI 不能防御以你的身份运行的恶意软件：同一用户下的其他程序理论上可以解密。请只在可信的电脑上使用。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 本地数据本身不能直接复制到其他电脑使用。换电脑、重装系统或更换 Windows 账户时，请使用上方“完整数据备份与迁移”（密码加密，含 Key），或重新输入 Key。鉴别记录与连接记录的导出报告不含 Key。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 界面不会回显已保存的 Key。编辑配置时 Key 留空表示保留原 Key。" />
                    <TextBlock Style="{StaticResource Para}" Margin="0"
                               Text="• 删除配置不是安全擦除：为了继续给历史记录脱敏，旧密钥会以加密形式保留在本地数据和备份中。如需让 Key 彻底失效，请到中转站后台撤销。" />
                </StackPanel>
            </Border>

            <!-- 网络行为 -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHead}">
                        <Border Style="{StaticResource IconBadge}">
                            <Path Data="{StaticResource IconGlobe}" Style="{StaticResource LineIcon}" Stroke="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="网络行为" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 启动时读取本地数据。两类自动巡检只在开启、有授权目标且到期时运行。此前已提交且有远端任务标识的身份巡检只恢复查询，不重新提交或补交旧轮剩余目标。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 提交检测会把完整 API Key 发给 BazaarLink，可能产生费用，报告可能公开，且服务方的保留策略尚未确认。建议使用低额度、可撤销的测试专用 Key。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 自动查询每 5 秒一次，同一时间只有一个请求；连续失败或断网会暂停，需要你手动恢复。停止查询或关闭程序不会停止远端检测。" />
                    <TextBlock Style="{StaticResource Para}" Margin="0"
                               Text="• 检测结果是服务基于样本的概率性判断，不是模型身份或能力的确定性证明。" />
                </StackPanel>
            </Border>

            <!-- Base URL -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHead}">
                        <Border Style="{StaticResource IconBadge}">
                            <Path Data="{StaticResource IconLink}" Style="{StaticResource LineIcon}" Stroke="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="API Base URL 怎么填" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Para}" Text="填写中转站 API 的根路径，通常以 /v1 结尾。先在配置里选好 API 协议，程序会按协议追加具体接口名：" />
                    <Border Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <TextBox Style="{StaticResource ValueText}" FontFamily="{StaticResource MonoFont}"
                                 Text="https://relay.example.com/v1" AutomationProperties.Name="Base URL 示例" />
                    </Border>
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 拉取模型列表请求 {Base URL}/models；连接测试按协议请求 {Base URL}/responses（OpenAI Responses，新建配置默认）、{Base URL}/messages（Claude Messages，使用 x-api-key 与 anthropic-version 请求头）或 {Base URL}/chat/completions（Chat Completions，兼容旧配置）。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 程序不会猜测或自动补 /v1，也不会在失败后改用其他协议重试。不要在 Base URL 里填写 /models、/responses、/messages 或 /chat/completions。" />
                    <TextBlock Style="{StaticResource Para}" Margin="0"
                               Text="• 仅支持 https 公网地址；不跟随重定向，不读取系统代理。" />
                </StackPanel>
            </Border>

            <!-- 尚待确认 -->
            <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Callout}" Padding="20" CornerRadius="10" Margin="0,0,0,20"
                    VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Path Data="{StaticResource IconAlert}" Style="{StaticResource LineIcon}" Stroke="{StaticResource WarningBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="尚待确认的事项" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 本程序仅供个人自用。BazaarLink Probe 的原生客户端访问规则、私密报告、密钥与报告保留期限、取消与幂等支持，以及再分发/商用许可均尚未确认。" />
                    <TextBlock Style="{StaticResource Para}" Margin="0"
                               Text="• 条款：https://bazaarlink.ai/terms　隐私：https://bazaarlink.ai/privacy" />
                </StackPanel>
            </Border>
            <!-- 本地直连连接测试 -->
            <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHead}">
                        <Border Style="{StaticResource IconBadge}">
                            <Path Data="{StaticResource IconProbe}" Style="{StaticResource LineIcon}" Stroke="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="本地直连连接测试" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 位于“模型与检测”页，独立于“提交 BazaarLink 鉴别检测”。它按该配置所选的协议，直接向你的中转站发送一次 POST（Responses、Messages 或 Chat Completions），携带该配置的 API Key，不经过 BazaarLink，不自动补 /v1，不跟随重定向，不自动重试，也不切换其他协议。更改配置的协议后，旧的模型缓存可能被清空，连接测试目标会取消，全局巡检的授权范围需要重新确认。卡片内只做单个模型的手动测试，定时测试已移到“连接巡检”页。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• “本地检查”不联网，只检查格式。确认模型可用必须实际发送请求：全部直连连接测试（手动与连接巡检）每次发送约256 token合成英文文本（实际 token 数随模型分词方式变化，不是256k上下文压力测试），内含首、中、尾三个随机标记；OpenAI Responses 请求参数为 max_output_tokens=64，Claude Messages 与 Chat Completions 为 max_tokens=64，单次请求超时保持约 45 秒。这是真实模型调用，可能产生费用；实际计费含输入、可能的隐藏推理和最低计费，以中转站为准，这些数值只是预计输出上限而非成本上限。每次手动测试都会先确认，选“否”不联网。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 单次测试分四项独立状态显示：本地检查、API 响应、模型响应、标记读取。收到 HTTP 响应（包括 401、404、429）不等于模型可用；只有收到有效的模型消息才算连接“成功”，且仅代表本次调用收到兼容响应，不验证模型真实身份或能力。连接结果统一分为三类：成功（绿色）、成功（可能，没有确认到有效的模型消息，不能当作确认成功，也不能当作失败，以蓝色显示）、失败（红色，含超时、连接中断、HTTP 5xx 等未确认响应的情况；跳过与删除不归入失败）。“标记读取”单独校验本次是否按格式返回三个标记：通过（绿色）、不匹配（蓝色）、无法判断（红色），旧历史记录无校验证据时显示“未检验”（红色）且不追溯补判；仅反映本次读标记与按格式回答情况，不证明真实身份能力。标记不匹配不等于断连或降智，不改变三类连接结果与统计，也不触发重试或连接问题通知。超时、中断等未收到完整响应的情况不能断定没有产生费用。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 在“连接巡检”页用“确认巡检设置…”保存配置、模型、间隔和最大重试次数。编辑不会改变当前轮或自动使用的设置；确认后从下一轮生效。两类巡检分别确认，清空范围不会关闭开关。原地升级保留开关、间隔、选择和历史；旧授权须重新确认，不用重新开关。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 最大重试可选 0、1、2 次，默认 0。首测不算重试，所以每目标每轮最多 1、2、3 次请求，不是费用上限。确认成功即止；401/403 暂停配置，429 按主机冷却，均不重试。每次请求分别保存；按本轮最好结果统计（成功 ＞ 成功（可能）＞ 失败，同级取最新），标记读取、时间和说明来自同一条记录。单次手动直连和身份提交不重试。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 每页分别按最近一轮正常结束时间（含立即巡检）加已确认间隔排期。重启或改间隔后，未到期继续等；已到期且可以运行时只跑一轮。不重叠、不补跑。关闭停止后续发送，已发出的请求无法撤回。有未确认草稿时，立即巡检先提示确认设置。" />
                    <TextBlock Style="{StaticResource Para}" Margin="0"
                               Text="• 记录分开保存：直连连接记录在“连接记录”窗口，BazaarLink 鉴别记录在“模型鉴别记录”窗口，两个窗口可同时打开，关闭窗口不影响巡检。“连接巡检”从不调用 BazaarLink；BazaarLink 鉴别有两类来源：你手动确认提交，或“身份识别巡检”（手动一轮或你授权后的定时轮次，见下方说明）。鉴别记录标有来源：手动、身份巡检（手动一轮）、身份巡检（定时），以及旧版“能力自动”历史记录；旧版记录保持原有标签，不会被改写成新的来源，也不会自动恢复查询。" />
                    <TextBlock Style="{StaticResource Para}" Margin="0,8,0,0"
                               Text="• 提交 BazaarLink 鉴别检测对 Chat Completions、OpenAI Responses、Claude Messages 三种协议的配置都开放：BazaarLink 官方公开前端提供这三种 upstreamFormat。但本程序尚未用真实中转站对三种格式做过端到端验证，提交可能被拒绝或返回不兼容的结果；确认框会显示本次使用的协议，也不会改用其他协议发送。" />
                </StackPanel>
            </Border>

            <!-- 身份识别巡检 -->
            <Border Grid.Row="5" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHead}">
                        <Border Style="{StaticResource IconBadge}">
                            <Path Data="{StaticResource IconShield}" Style="{StaticResource LineIcon}" Stroke="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="身份识别巡检" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 对你勾选的配置和模型，每轮逐个向 BazaarLink 提交官方身份识别（Probe）：POST https://bazaarlink.ai/api/probe/run 提交，GET /api/probe/run/{runId} 只读查询。每轮冻结目标清单，当前目标结束后才处理下一个；只使用已勾选、仍有缓存且已授权的模型，空选择不会发送，新增模型默认不选。不生成综合降智总分，也不做任何能力题或基线检测。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 提交会把完整 API Key、目标地址、模型和协议发给 BazaarLink，可能产生费用，报告可能公开。确认巡检设置及每次立即巡检均列明精确目标和接收方，不显示密钥值。建议使用低额度、可撤销的测试专用 Key。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 两页自动巡检默认关闭，间隔默认 30 分钟，可设 10 至 480 分钟的整数。身份识别巡检独立确认，按本页最近正常结束时间排期。没有可信的上一轮结束时间时视为到期。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 等待结果复用“鉴别记录”同一个查询通道（每条记录同一时间只有一个请求），不会重复查询。单个目标最多等待 10 分钟，这只是本地等待上限，不是远端任务或费用上限。等待超时、结果未知、查询暂停或被限流（HTTP 429）会停止本轮剩余目标，不补交、不自动重试，远端任务不视为已取消，之后只能在“鉴别记录”中恢复查询。明确结束的失败会继续下一个目标；身份不符或警示是检测结果，不阻止轮次继续。已有未结束或结果未知的鉴别任务时不会再提交。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 关闭开关会停止后续派发并取消定时轮的本地等待，但已发送的任务无法撤回，也不保证停止计费。401/403 会暂停对应配置，429 会让官方主机进入冷却。检测结果只是服务基于样本的概率性判断，不是模型真实身份的确定性证明。" />
                    <TextBlock Style="{StaticResource Para}" Margin="0"
                               Text="• 旧版“降智巡检”（能力题与基线）已移除；其历史鉴别记录仍保留并标为“旧版能力自动”，不会触发任何自动检测。" />
                </StackPanel>
            </Border>

            <!-- Windows 问题通知 -->
            <Border Grid.Row="6" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,20"
                    DataContext="{Binding Notifications}">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHead}">
                        <Border Style="{StaticResource IconBadge}">
                            <Path Data="{StaticResource IconAlert}" Style="{StaticResource LineIcon}" Stroke="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Windows 问题通知" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 连接巡检和定时身份识别巡检发现问题时，可通过托盘图标弹出 Windows 通知。两个开关相互独立，默认都开启；它们只控制是否提示，不授予任何检测或外发权限，关闭也不会停止检测。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 同一时刻出现的同类问题会合并成一条：连接巡检按轮合并；身份识别巡检在每个目标结束时即时提示，所以一轮里可能有多条通知。同一目标的同一问题不重复提示，恢复正常后再次出现才会再提示。只有自动轮次才会通知，手动运行（含手动一轮）不通知。通知内容不含密钥、完整地址或原始回答。" />
                    <CheckBox Content="连接问题（连接巡检）" IsChecked="{Binding Connection}" IsEnabled="{Binding IsAvailable}" Margin="0,4,0,6"
                              AutomationProperties.Name="连接问题通知开关" />
                    <CheckBox Content="身份问题（定时身份识别巡检发现异常、失败或结果未知）" IsChecked="{Binding Identity}" IsEnabled="{Binding IsAvailable}" Margin="0,0,0,10"
                              AutomationProperties.Name="身份问题通知开关" />
                    <WrapPanel>
                        <Button Content="保存偏好" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6" MinWidth="96" Command="{Binding SaveCommand}"
                                AutomationProperties.Name="保存通知偏好" />
                        <Button Content="测试本地通知" Margin="0,0,10,6" Command="{Binding TestCommand}"
                                AutomationProperties.Name="测试本地通知"
                                ToolTip="只在本机弹出一条测试通知，不联网，不含检测数据。" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DirtyHint}" Style="{StaticResource Hint}" Visibility="{Binding DirtyHint, Converter={StaticResource HasValueToVis}}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="通知是否显示还取决于 Windows 的通知与专注助手设置；本程序只能提交到通知区域，无法确认系统已送达。通知失败不会影响检测结果。" />
                </StackPanel>
            </Border>

            <!-- 托盘与退出 -->
            <Border Grid.Row="7" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Style="{StaticResource CardHead}">
                        <Border Style="{StaticResource IconBadge}">
                            <Path Data="{StaticResource IconGlobe}" Style="{StaticResource LineIcon}" Stroke="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="最小化到托盘与退出" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 点击最小化后，窗口会隐藏到通知区域（任务栏右侧，图标可能在“显示隐藏的图标”溢出菜单里）。最小化不等于退出：程序仍在运行，已开启的全局连接巡检和身份识别巡检会继续按间隔运行，可能产生费用（身份识别会向 BazaarLink 提交）。托盘右键菜单还可直接打开“连接记录”和“模型鉴别记录”窗口。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 双击托盘图标，或右键选择“打开主窗口”可恢复窗口；右键“退出”与点击窗口右上角的 X 一样，会真实退出程序，存在进行中的任务或开启的全局巡检时会先提示确认；取消则程序和托盘图标保持不变。" />
                    <TextBlock Style="{StaticResource Para}"
                               Text="• 退出只会停止本机的巡检计时和查询，已发出的请求无法撤回，BazaarLink 上的远端检测也不会因此停止。退出时开关保持你上次的选择：已开启且范围仍已授权时，下次启动会自动恢复巡检；最小化不会改变开关。" />
                    <TextBlock Style="{StaticResource Para}" Margin="0"
                               Text="• 同一数据目录只允许运行一个程序。再次启动不会唤醒已隐藏的窗口，只会提示你从通知区域打开。" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
