<UserControl x:Class="ProbeDesktop.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ProbeDesktop.App.Views"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="400" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="6*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Text="模型鉴别记录" Style="{StaticResource PageTitle}" FontWeight="Normal" />
            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,0"
                       Text="BazaarLink 鉴别检测的本地历史，只保存在本机。选择记录只显示本地数据，不会联网；需要更新进度时请点击“查询一次”或“恢复自动查询”。" />
        </StackPanel>

        <!-- 筛选：第一行三个等宽字段；第二行左侧日期对、右侧操作按钮。日期对不会被换行孤立 -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="配置" Style="{StaticResource ToolbarLabel}" />
                        <ComboBox x:Name="ProfileFilterBox" Style="{StaticResource ToolbarCombo}" ItemsSource="{Binding ProfileOptions}"
                                  SelectedItem="{Binding ProfileFilter}" DisplayMemberPath="Label" AutomationProperties.Name="按配置筛选" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="模型" Style="{StaticResource ToolbarLabel}" />
                        <TextBox x:Name="ModelFilterBox" Style="{StaticResource ToolbarSearch}" Tag="模型名称"
                                 Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="按模型筛选" ToolTip="匹配调用模型、声明模型或推测模型" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="状态" Style="{StaticResource ToolbarLabel}" />
                        <ComboBox x:Name="StateFilterBox" Style="{StaticResource ToolbarCombo}" ItemsSource="{Binding StateOptions}"
                                  SelectedItem="{Binding StateFilter}" DisplayMemberPath="Label" AutomationProperties.Name="按状态筛选" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="开始日期" Style="{StaticResource ToolbarLabel}" />
                            <DatePicker x:Name="FromBox" Width="140" Style="{StaticResource ToolbarDate}" SelectedDate="{Binding FromDate}" AutomationProperties.Name="开始日期" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="结束日期" Style="{StaticResource ToolbarLabel}" />
                            <DatePicker x:Name="ToBox" Width="140" Style="{StaticResource ToolbarDate}" SelectedDate="{Binding ToDate}" AutomationProperties.Name="结束日期" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="清除筛选" Style="{StaticResource ToolbarTertiaryButton}" Command="{Binding ClearFiltersCommand}" AutomationProperties.Name="清除筛选" />
                        <Button Content="重新读取" Style="{StaticResource ToolbarButton}" Command="{Binding ReloadCommand}"
                                AutomationProperties.Name="重新读取本地历史" ToolTip="从本地文件重新读取历史，不联网" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 左：列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                    <TextBlock Text="记录列表" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding CountText}" />
                </DockPanel>
                <Grid>
                    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutomationProperties.Name="历史记录列表"
                          CanUserSortColumns="False" Margin="0,0,0,8" MinRowHeight="48">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding CreatedAtText}" Width="112" MinWidth="112"
                                            ElementStyle="{StaticResource ClampCell}" />
                        <DataGridTextColumn Header="配置" Binding="{Binding ProfileName}" Width="96" MinWidth="72" ElementStyle="{StaticResource TrimCell}" />
                        <DataGridTextColumn Header="模型" Binding="{Binding ModelId}" Width="*" MinWidth="80" ElementStyle="{StaticResource TrimCell}" />
                        <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="150" MinWidth="96" ElementStyle="{StaticResource ClampCell}" />
                        <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="84" MinWidth="72" ElementStyle="{StaticResource ClampCell}" />
                    </DataGrid.Columns>
                </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding View.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SubtleBrush}" HorizontalAlignment="Center"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Path Data="{StaticResource IconHistory}" Style="{StaticResource LineIcon}" Width="22" Height="22" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="暂无可显示的记录" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="还没有鉴别记录，或没有符合筛选条件的记录。提交检测后会出现在这里；可点击“清除筛选”。" Style="{StaticResource Hint}" TextAlignment="Center" MaxWidth="320" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 右：详情 -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SubtleBrush}" HorizontalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Path Data="{StaticResource IconHistory}" Style="{StaticResource LineIcon}" Width="22" Height="22" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="未选择记录" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="在左侧选择一条记录查看详情。" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                </StackPanel>
                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="导出 JSON…" Style="{StaticResource ToolbarButton}" Command="{Binding ExportCommand}" Margin="0,0,8,0"
                                        AutomationProperties.Name="导出检测记录" ToolTip="导出脱敏后的结果摘要，不含 Key" />
                                <Button Content="删除本地记录" Style="{StaticResource ToolbarDangerButton}" Margin="0" Command="{Binding DeleteCommand}"
                                        AutomationProperties.Name="删除本地记录" ToolTip="只删除本机记录，不影响远端" />
                            </StackPanel>
                            <TextBlock Text="记录详情" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="20,16">
                        <views:RunDetailView DataContext="{Binding Selected}" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
