<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ProbeDesktop.App.Converters">

    <!-- 蓝白简约商务配色。正文/辅助文字与白底、页面底的对比度均 ≥ 4.5:1。 -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>
    <Color x:Key="PrimaryDarkColor">#1E40AF</Color>
    <Color x:Key="PrimaryLightColor">#EEF4FF</Color>
    <Color x:Key="PageColor">#F5F7FB</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E7ECF3</Color>
    <Color x:Key="InputBorderColor">#CBD5E1</Color>
    <Color x:Key="TextColor">#1E293B</Color>
    <Color x:Key="MutedTextColor">#5B6B82</Color>
    <Color x:Key="DangerColor">#B42318</Color>
    <Color x:Key="WarningColor">#8A4B00</Color>
    <Color x:Key="SuccessColor">#17663A</Color>
    <Color x:Key="FocusColor">#2563EB</Color>
    <!-- “成功（可能）”专用提示色：青蓝，区别于成功绿、警告琥珀与主色蓝；对白底对比度约 6:1。 -->
    <Color x:Key="PossibleColor">#0F6A7A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimarySoftBorderBrush" Color="#C7D7FB" />
    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="PressedBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FEF3F2" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F4C7C3" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FFF8EB" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#F3D9A4" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#ECFDF3" />
    <SolidColorBrush x:Key="PossibleBrush" Color="{StaticResource PossibleColor}" />
    <SolidColorBrush x:Key="PossibleLightBrush" Color="#E8F6F8" />
    <SolidColorBrush x:Key="PossibleBorderBrush" Color="#A9D8DF" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#7A8699" />
    <!-- 兼容旧键 -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource PrimaryLightColor}" />

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    <conv:HasValueToVisibilityConverter x:Key="HasValueToVis" />
    <conv:HasValueToVisibilityConverter x:Key="NoValueToVis" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />

    <!-- 线性图标（24×24 坐标系，描边绘制，不依赖外部图片或图标字体） -->
    <Geometry x:Key="IconProfiles">M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M8,4 L8,8 M15,10 L15,14 M10,16 L10,20</Geometry>
    <Geometry x:Key="IconProbe">M4,10.5 A6.5,6.5 0 1 1 17,10.5 A6.5,6.5 0 1 1 4,10.5 Z M15.3,15.3 L20,20 M7.8,10.6 L9.9,12.6 L13.4,8.6</Geometry>
    <Geometry x:Key="IconHistory">M4,12 A8,8 0 1 1 20,12 A8,8 0 1 1 4,12 Z M12,8 L12,12 L15,14</Geometry>
    <Geometry x:Key="IconHelp">M4,12 A8,8 0 1 1 20,12 A8,8 0 1 1 4,12 Z M12,11 L12,16 M12,8 L12,8.3</Geometry>
    <Geometry x:Key="IconSearch">M5,10.5 A5.5,5.5 0 1 1 16,10.5 A5.5,5.5 0 1 1 5,10.5 Z M14.5,14.5 L19,19</Geometry>
    <Geometry x:Key="IconEmptyBox">M4,9 L12,5 L20,9 L20,17 L12,21 L4,17 Z M4,9 L12,13 L20,9 M12,13 L12,21</Geometry>
    <Geometry x:Key="IconDocument">M6,3 L14,3 L19,8 L19,21 L6,21 Z M14,3 L14,8 L19,8 M9,13 L16,13 M9,17 L14,17</Geometry>
    <Geometry x:Key="IconShield">M12,3 L19,6 L19,11 C19,15.5 16,19 12,21 C8,19 5,15.5 5,11 L5,6 Z M9,12 L11,14 L15,10</Geometry>
    <Geometry x:Key="IconFolder">M3,6 L9,6 L11,8 L21,8 L21,19 L3,19 Z</Geometry>
    <Geometry x:Key="IconGlobe">M4,12 A8,8 0 1 1 20,12 A8,8 0 1 1 4,12 Z M4,12 L20,12 M12,4 C9,7 9,17 12,20 C15,17 15,7 12,4</Geometry>
    <Geometry x:Key="IconAlert">M12,4 L21,20 L3,20 Z M12,10 L12,14.5 M12,17 L12,17.3</Geometry>
    <Geometry x:Key="IconLink">M10,14 L14,10 M8.5,11.5 L6.5,13.5 A3,3 0 0 0 10.5,17.5 L12.5,15.5 M15.5,12.5 L17.5,10.5 A3,3 0 0 0 13.5,6.5 L11.5,8.5</Geometry>

    <Style x:Key="LineIcon" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- 键盘焦点：蓝色外框 -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="9" RadiusY="9" SnapsToDevicePixels="True"
                               Stroke="{StaticResource FocusBrush}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 页面根：显式正常文字，避免从 TabItem 等容器继承异常的颜色或字重 -->
    <Style x:Key="PageRoot" TargetType="UserControl">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="StepLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="Padding" Value="0,0,0,6" />
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- 小计数标签 -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
    </Style>
    <Style x:Key="Callout" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="InfoCallout" TargetType="Border" BasedOn="{StaticResource Callout}">
        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimarySoftBorderBrush}" />
    </Style>
    <Style x:Key="DangerCallout" TargetType="Border" BasedOn="{StaticResource Callout}">
        <Setter Property="Background" Value="{StaticResource DangerLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
    </Style>
</ResourceDictionary>
